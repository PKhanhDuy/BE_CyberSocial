DB_URL=jdbc:postgresql://host/database?sslmode=require
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

BACKEND_PORT=8080

# Shared secret between backend and AI service (required in Docker/production)
AI_SERVICE_API_KEY=replace-with-a-long-random-secret
TGNN_MODEL_PATH=models/tgnn_tice.pt
TGNN_ST_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TGNN_THRESHOLD=0.5

# LLM narration — viết lại headline/narrative (fallback template nếu lỗi)
# Provider: none | gemini | ollama
LLM_NARRATION_PROVIDER=none

# Gemini (free tier — khuyên dùng khi deploy)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30


AI_AUTO_ANALYSIS_ENABLED=true
AI_AUTO_ANALYSIS_DEBOUNCE_MINUTES=3
AI_SERVICE_TIMEOUT_SECONDS=30

JWT_SECRET=replace-with-at-least-64-random-characters-for-local-development-only
JWT_ISSUER=cybersocial
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_REFRESH_TOKEN_SESSION_DAYS=1

# Refresh cookie. Keep secure=true in production (HTTPS).
# Set AUTH_COOKIE_SECURE=false only if your browser refuses the cookie over plain http://localhost.
# Use SameSite=None (requires secure=true) when frontend and backend sit on different sites.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cybersocial/posts
UPLOAD_MAX_IMAGE_SIZE=5MB
