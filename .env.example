DB_URL=jdbc:postgresql://host/database?sslmode=require
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

REDIS_PORT=6379

BACKEND_PORT=8080
AI_SERVICE_PORT=8000
TGNN_MODEL_PATH=models/tgnn_deployment.pth
TGNN_ST_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TGNN_THRESHOLD=0.5

AI_AUTO_ANALYSIS_ENABLED=true
AI_AUTO_ANALYSIS_DEBOUNCE_MINUTES=3
AI_SERVICE_TIMEOUT_SECONDS=30

JWT_SECRET=replace-with-at-least-64-random-characters-for-local-development-only
JWT_ISSUER=cybersocial
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cybersocial/posts
UPLOAD_MAX_IMAGE_SIZE=5MB
